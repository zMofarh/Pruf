# بدون هذه المفاتيح يعمل الموقع في "الوضع التجريبي" (حسابات محلية في المتصفح)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# للتطبيق والفحص من الطرفية فقط (npm run db:apply / npm run check:backend) — لا تُرفع لـVercel
SUPABASE_DB_URL=

# بريد/بُرُد المدراء (مفصولة بفواصل) — في Supabase يُفضّل ضبط app_metadata.role = "admin"
VITE_ADMIN_EMAILS=

# أزرار «دخول كمالك المنصة / كفريق» في النسخة التجريبية (بلا Supabase) — مفعّلة افتراضياً؛ ضع false لإخفائها.
# لا أثر لها حين يُضبط Supabase: الدخول التجريبي معطّل هناك دائماً.
VITE_ENABLE_DEMO_ADMIN=true

# نقاط استقبال النماذج عند عدم استخدام Supabase (الافتراضي: نماذج Readdy الحالية)
VITE_CONTACT_FORM_URL=
VITE_CONSULTATION_FORM_URL=
VITE_NEWSLETTER_FORM_URL=
VITE_DESIGN_FORM_URL=
VITE_BRIEF_FORM_URL=

# مكالمة الاكتشاف: رابط Cal.com أو Calendly اختياري (يحل محل نموذج الحجز الداخلي)
VITE_BOOKING_URL=
VITE_BOOKING_FORM_URL=
VITE_KIT_FORM_URL=

# الدفع عبر مويسر (مدى، Apple Pay، STC Pay، بطاقات) — بدون المفتاح العام تعود العينة لمسار "سنتواصل لإتمام الدفع"
VITE_MOYASAR_PUBLISHABLE_KEY=
# مفاتيح الخادم فقط (Vercel Function) — لا تضف لها بادئة VITE_ أبداً
MOYASAR_SECRET_KEY=
KIT_PRICE_HALALAS=75000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# تحويل صور المنتجات إلى 3D بالذكاء الاصطناعي (api/ai3d.ts) — مفاتيح الخادم فقط، بدون VITE_
AI3D_PROVIDER=meshy
MESHY_API_KEY=
# اختياري: يُترك فارغاً لاستخدام أحدث نموذج لدى Meshy
MESHY_AI_MODEL=
# بديل: AI3D_PROVIDER=fal مع FAL_KEY (افتراضي FAL_MODEL=fal-ai/trellis-2)
FAL_KEY=
FAL_MODEL=
# يستخدمها الخادم للتحقق من صلاحية المستخدم ولحفظ النماذج في Storage
SUPABASE_ANON_KEY=

# التحقق البشري (Cloudflare Turnstile) — اختياري. المفتاح العام للواجهة، والسري للخادم فقط (api/lead.ts)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# إشعار فوري للفريق بكل طلب (api/lead-notify.ts) — مفاتيح الخادم فقط، بدون VITE_
LEAD_WEBHOOK_SECRET=
SITE_URL=
NOTIFY_KINDS=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
NOTIFY_WHATSAPP_TO=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=ar
# قالب رسائل العميل (api/client-notify.ts)
CLIENT_WHATSAPP_TEMPLATE=
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
NOTIFY_WEBHOOK_URL=
